# 必填：MySQL SQLAlchemy 连接串。
SQLALCHEMY_DATABASE_URL=replace-with-your-database-url

# 必填：DashScope API Key。
DASHSCOPE_API_KEY=replace-with-your-api-key

# 启用 Agent 功能时必填：DeepSeek API Key，只用于 Agent LLM。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# 可按部署环境覆盖的服务地址与运行参数。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=knowledge_chunks
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=10
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
CONTEXT_ROUTE_LOCK_TIMEOUT_SECONDS=240
CONTEXT_ROUTE_LOCK_BLOCKING_TIMEOUT_SECONDS=5
CONTEXT_RESOURCE_QUEUE_MAX_SIZE=16
DOCLING_SERVER_URL=http://115.29.238.225:5001
DOCLING_TIMEOUT_SECONDS=180
DOCLING_OUTPUT_TYPE=md
LOG_STORAGE_DIR=logs
